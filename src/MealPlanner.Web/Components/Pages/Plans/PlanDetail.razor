@page "/plans/{PlanId:guid}"
@using MealPlanner.Application.Abstractions.Authentication
@using MealPlanner.Application.Abstractions.Messaging
@using MealPlanner.Application.MealPlans.GenerateMealPlan
@using MealPlanner.Application.MealPlans.GetMealPlan
@using MealPlanner.Application.MealPlans.RegenerateMealPlan
@using MealPlanner.Application.MealPlans.ReplaceDish
@using MealPlanner.Application.MealPlans.SetEntryLock
@using MealPlanner.Domain.Abstractions
@using MealPlanner.Domain.Shared
@attribute [Authorize]
@rendermode InteractiveServer
@inject IUserContext UserContext
@inject IQueryHandler<GetMealPlanQuery, MealPlanResponse> Plans
@inject ICommandHandler<ReplaceDishCommand, ReplaceDishResponse> Replace
@inject ICommandHandler<RegenerateMealPlanCommand, GenerateMealPlanResponse> Regenerate
@inject ICommandHandler<SetEntryLockCommand> SetLock

@* The page is interactive because of the dish replacement *@

<PageTitle>@(_plan?.Name ?? "Plan")</PageTitle>

@if (_error is not null)
{
    <div class="card">
        <h1>Plan not found</h1>
        <p class="muted">@_error</p>
        <a class="button" href="plans">Back to Plans</a>
    </div>
}
else if (_plan is not null)
{
    <div class="card">
        <h1>@_plan.Name</h1>

        <dl class="facts">
            <div><dt>Duration</dt><dd>@_plan.StartDate.ToString("dd.MM") – @_plan.StartDate.AddDays(_plan.DurationDays - 1).ToString("dd.MM.yyyy")</dd></div>
            <div><dt>Cost</dt><dd>@_plan.TotalCost.ToString("0.##") @_plan.Currency</dd></div>
            <div><dt>Budget</dt><dd>@_plan.Budget.ToString("0.##") @_plan.Currency</dd></div>
            <div><dt>Diversity</dt><dd>@_plan.DiversityIndex.ToString("0.00")</dd></div>
        </dl>

        <p class="muted">
            Generated by «@Names.Of(_plan.Algorithm)» in @_plan.GenerationMs ms@(
            _plan.ExploredNodes > 0 ? $", {_plan.ExploredNodes:N0} nodes explored" : "").
        </p>

        @if (_lastReplacement is not null)
        {
            <p class="alert info">
                «@_lastReplacement.OldDishName» was replaced with «@_lastReplacement.NewDishName».
                The distance in similarity-graph: @_lastReplacement.Distance.ToString("0.###"),
                path length: @_lastReplacement.PathLength nodes,
                explored: @_lastReplacement.ExploredNodes nodes.
            </p>
        }

        @if (_replaceError is not null)
        {
            <p class="alert error">@_replaceError</p>
        }

        <p class="actions">
            <button class="primary" disabled="@_busy" @onclick="RegenerateAsync">
                Generate another version
            </button>
            <span class="muted">
                Locked entries will not change, while all other dishes will be replaced.
            </span>
        </p>
    </div>

    @foreach (MealPlanDayResponse day in _plan.Days)
    {
        <div class="card">
            <h2>Day @day.DayNumber - @day.Date.ToString("dd.MM, dddd")</h2>

            <table>
                <thead>
                    <tr>
                        <th>Meal</th>
                        <th>Dish</th>
                        <th class="number">Kcal</th>
                        <th class="number">Cost</th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (MealPlanEntryResponse meal in day.Meals)
                    {
                        <tr>
                            <td>@Names.Of(meal.MealType)</td>
                            <td>@meal.DishName</td>
                            <td class="number">@meal.Calories</td>
                            <td class="number">@meal.Cost.ToString("0.##")</td>
                            <td>
                                <button disabled="@(_busy || meal.IsLocked)"
                                        @onclick="() => ReplaceAsync(day.DayNumber, meal)">
                                    Replace
                                </button>
                            </td>
                            <td>
                                <button disabled="@_busy"
                                        @onclick="() => ToggleLockAsync(day.DayNumber, meal)">
                                    @(meal.IsLocked ? "Unlock" : "Lock")
                                </button>
                            </td>
                        </tr>
                    }
                    <tr class="total">
                        <td colspan="2">Daily total</td>
                        <td class="number">@day.Calories</td>
                        <td class="number">@day.Cost.ToString("0.##")</td>
                        <td></td>
                        <td></td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
}

@code {
    [Parameter]
    public Guid PlanId { get; set; }

    private MealPlanResponse? _plan;
    private string? _error;
    private string? _replaceError;
    private ReplaceDishResponse? _lastReplacement;
    private bool _busy;

    // Dishes, rejected by the user for each slot. this state lives in the current session because
    // it represents the current interaction with user, not the actual meal plan. Reloading the page
    // reasonably starts the interaction again, there's no need to remember old rejections for a long time.
    private readonly Dictionary<(int Day, MealType Meal), HashSet<Guid>> _rejected = [];

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        Result<UserId> userId = await UserContext.GetUserIdAsync();

        if (userId.IsFailure)
        {
            _error = userId.Error.Description;

            return;
        }

        Result<MealPlanResponse> result = await Plans.Handle(
            new GetMealPlanQuery(PlanId, userId.Value),
            CancellationToken.None);

        if (result.IsFailure)
        {
            _error = result.Error.Description;

            return;
        }

        _plan = result.Value;
    }

    private async Task ReplaceAsync(int dayNumber, MealPlanEntryResponse meal)
    {
        _busy = true;
        _replaceError = null;

        try
        {
            Result<UserId> userId = await UserContext.GetUserIdAsync();

            if (userId.IsFailure)
            {
                _replaceError = userId.Error.Description;

                return;
            }

            (int, MealType) slot = (dayNumber, meal.MealType);

            if (!_rejected.TryGetValue(slot, out HashSet<Guid>? rejected))
            {
                rejected = [];
                _rejected[slot] = rejected;
            }

            // User rejects the dish that is shown in the slot currently, so it is added to rejected set before
            // requesting replacement. Otherwise another replacement request could possibly return this dish again.
            rejected.Add(meal.DishId);

            Result<ReplaceDishResponse> result = await Replace.Handle(
                new ReplaceDishCommand(userId.Value, PlanId, dayNumber, meal.MealType, [.. rejected]),
                CancellationToken.None);

            if (result.IsFailure)
            {
                _replaceError = result.Error.Description;

                return;
            }

            _lastReplacement = result.Value;

            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ToggleLockAsync(int dayNumber, MealPlanEntryResponse meal)
    {
        _busy = true;
        _replaceError = null;

        try
        {
            Result<UserId> userId = await UserContext.GetUserIdAsync();

            if (userId.IsFailure)
            {
                _replaceError = userId.Error.Description;

                return;
            }

            Result result = await SetLock.Handle(
                new SetEntryLockCommand(
                    userId.Value, PlanId, dayNumber, meal.MealType, !meal.IsLocked),
                CancellationToken.None);

            if (result.IsFailure)
            {
                _replaceError = result.Error.Description;

                return;
            }

            // Locking a dish resets for this slot the rejected-dish
            // set - the user wants to keep this specific dish. 
            _rejected.Remove((dayNumber, meal.MealType));

            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RegenerateAsync()
    {
        _busy = true;
        _replaceError = null;
        _lastReplacement = null;

        try
        {
            Result<UserId> userId = await UserContext.GetUserIdAsync();

            if (userId.IsFailure)
            {
                _replaceError = userId.Error.Description;

                return;
            }

            Result<GenerateMealPlanResponse> result = await Regenerate.Handle(
                new RegenerateMealPlanCommand(userId.Value, PlanId),
                CancellationToken.None);

            if (result.IsFailure)
            {
                _replaceError = result.Error.Description;

                return;
            }

            // Previously rejected dishes belonged to the previous plan.
            // After regeneration the rejected set needs to starts again.
            _rejected.Clear();

            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}

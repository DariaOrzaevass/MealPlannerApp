@page "/plans/new"
@using MealPlanner.Application.Abstractions.Authentication
@using MealPlanner.Application.Abstractions.Messaging
@using MealPlanner.Application.Catalog.GetCatalogOptions
@using MealPlanner.Application.MealPlans
@using MealPlanner.Application.MealPlans.CompareSolvers
@using MealPlanner.Application.MealPlans.GenerateMealPlan
@using MealPlanner.Domain.Abstractions
@using MealPlanner.Domain.MealPlans
@using MealPlanner.Domain.Shared
@attribute [Authorize]
@rendermode InteractiveServer
@inject IUserContext UserContext
@inject IQueryHandler<GetCatalogOptionsQuery, CatalogOptionsResponse> Options
@inject IQueryHandler<CompareSolversQuery, IReadOnlyCollection<SolverComparisonRow>> Compare
@inject ICommandHandler<GenerateMealPlanCommand, GenerateMealPlanResponse> Generate
@inject NavigationManager Navigation

@* This page is interactive, here user ticks checkboxes and
presses buttons and the result must apper without the reload. *@

<PageTitle>Create a new plan</PageTitle>

<div class="card">
    <h1>Create a new plan</h1>

    @if (_options is null)
    {
        <p class="muted">Loading reference data...</p>
    }
    else
    {
        <div class="grid-2">
            <label>
                Name
                <input @bind="_name" />
            </label>

            <label>
                Start Date
                <input type="date" @bind="_startDate" />
            </label>

            <label>
                Budget for the whole period, €
                <input type="number" step="5" min="1" @bind="_budget" />
            </label>

            <label>
                Duration in days
                <input type="number" min="1" max="28" @bind="_durationDays" />
            </label>

            <label>
                Diet
                <select @bind="_diet">
                    @foreach (DietType diet in Enum.GetValues<DietType>())
                    {
                        <option value="@diet">@Names.Of(diet)</option>
                    }
                </select>
            </label>

            <label>
                Planning algorithm
                <select @bind="_algorithm">
                    @foreach (PlannerAlgorithm algorithm in Enum.GetValues<PlannerAlgorithm>())
                    {
                        <option value="@algorithm">@Names.Of(algorithm)</option>
                    }
                </select>
            </label>

            <label>
                Max number of dish repetitions
                <input type="number" min="1" @bind="_maxRepeats" />
            </label>

            <label>
                Min days between repetitions
                <input type="number" min="0" @bind="_minGap" />
            </label>

            <label>
                Min daily calories
                <input type="number" min="0" placeholder="no limit" @bind="_minCalories" />
            </label>

            <label>
                Max daily calories
                <input type="number" min="0" placeholder="no limit" @bind="_maxCalories" />
            </label>

            <label>
                Max cooking time in minutes
                <input type="number" min="1" placeholder="no limit" @bind="_maxCookingTime" />
            </label>
        </div>

        <h2>Meals</h2>
        <div class="checks">
            @foreach (MealType meal in Enum.GetValues<MealType>())
            {
                <label class="inline">
                    <input type="checkbox"
                           checked="@_meals.Contains(meal)"
                           @onchange="e => Toggle(_meals, meal, e)" />
                    @Names.Of(meal)
                </label>
            }
        </div>

        <h2>Exclude allergens</h2>
        <div class="checks">
            @foreach (AllergenOption allergen in _options.Allergens)
            {
                <label class="inline">
                    <input type="checkbox"
                           checked="@_allergens.Contains(allergen.Id)"
                           @onchange="e => Toggle(_allergens, allergen.Id, e)" />
                    @allergen.Name
                </label>
            }
        </div>

        <h2>Preffered cuisines</h2>
        <div class="checks">
            @foreach (Cuisine cuisine in Enum.GetValues<Cuisine>())
            {
                <label class="inline">
                    <input type="checkbox"
                           checked="@_cuisines.Contains(cuisine)"
                           @onchange="e => Toggle(_cuisines, cuisine, e)" />
                    @Names.Of(cuisine)
                </label>
            }
        </div>

        <h2>Disliked ingredients</h2>
        <details>
            <summary class="muted">Selected: @_ingredients.Count from @_options.Ingredients.Count</summary>
            <div class="checks">
                @foreach (IngredientOption ingredient in _options.Ingredients)
                {
                    <label class="inline">
                        <input type="checkbox"
                               checked="@_ingredients.Contains(ingredient.Id)"
                               @onchange="e => Toggle(_ingredients, ingredient.Id, e)" />
                        @ingredient.Name
                    </label>
                }
            </div>
        </details>

        @if (_errors.Count > 0)
        {
            <div class="alert error">
                <ul>
                    @foreach (string message in _errors)
                    {
                        <li>@message</li>
                    }
                </ul>
            </div>
        }

        <p class="actions">
            <button class="primary" disabled="@_busy" @onclick="BuildAsync">Generate plan</button>
            <button disabled="@_busy" @onclick="CompareAsync">Compare solvers</button>
            @if (_busy)
            {
                <span class="muted">Calculating</span>
            }
        </p>
    }
</div>

@if (_comparison is not null)
{
    <div class="card">
        <h2>Solver comparison</h2>
        <p class="muted">
            The same problem, four solvers. Nothing is saved.
        </p>

        <table>
            <thead>
                <tr>
                    <th>Solver</th>
                    <th class="number">Cost</th>
                    <th class="number">Budget</th>
                    <th class="number">Variety</th>
                    <th class="number">Time</th>
                    <th class="number">Nodes</th>
                </tr>
            </thead>
            <tbody>
                @foreach (SolverComparisonRow row in _comparison)
                {
                    <tr>
                        <td>@row.Name</td>
                        @if (row.Solved)
                        {
                            <td class="number">@row.TotalCost.ToString("0.##")</td>
                            <td class="number">@row.BudgetUsage.ToString("P0")</td>
                            <td class="number">@row.DiversityIndex.ToString("0.00")</td>
                            <td class="number">@row.ElapsedMs ms</td>
                            <td class="number">@(row.ExploredNodes == 0 ? "-" : row.ExploredNodes.ToString("N0"))</td>
                        }
                        else
                        {
                            <td colspan="3" class="muted">@row.Failure</td>
                            <td class="number">@row.ElapsedMs ms</td>
                            <td class="number">@(row.ExploredNodes == 0 ? "-" : row.ExploredNodes.ToString("N0"))</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private CatalogOptionsResponse? _options;
    private IReadOnlyCollection<SolverComparisonRow>? _comparison;
    private readonly List<string> _errors = [];
    private bool _busy;

    private string _name = "Week";
    private DateOnly _startDate = DateOnly.FromDateTime(DateTime.UtcNow);
    private decimal _budget = 20m;
    private int _durationDays = 7;
    private DietType _diet = DietType.Omnivore;
    private PlannerAlgorithm _algorithm = PlannerAlgorithm.Backtracking;
    private int _maxRepeats = 3;
    private int _minGap = 1;
    private int? _minCalories;
    private int? _maxCalories;
    private int? _maxCookingTime;

    private readonly HashSet<MealType> _meals =
        [MealType.Breakfast, MealType.Lunch, MealType.Dinner];

    private readonly HashSet<Guid> _allergens = [];
    private readonly HashSet<Guid> _ingredients = [];
    private readonly HashSet<Cuisine> _cuisines = [];

    protected override async Task OnInitializedAsync()
    {
        Result<CatalogOptionsResponse> options =
            await Options.Handle(new GetCatalogOptionsQuery(), CancellationToken.None);

        if (options.IsSuccess)
        {
            _options = options.Value;
        }
    }

    private static void Toggle<T>(HashSet<T> set, T value, ChangeEventArgs e)
    {
        if (e.Value is true)
        {
            set.Add(value);
        }
        else
        {
            set.Remove(value);
        }
    }

    private PlanningConstraintsInput BuildConstraints() => new(
        _budget,
        Currency.Eur.Code,
        _durationDays,
        [.. _meals.Order()],
        _diet,
        [.. _allergens],
        [.. _ingredients],
        _maxRepeats,
        _minGap,
        _minCalories,
        _maxCalories,
        _maxCookingTime,
        [.. _cuisines.Order()]);

    private async Task BuildAsync()
    {
        _busy = true;
        _errors.Clear();
        _comparison = null;

        try
        {
            Result<UserId> userId = await UserContext.GetUserIdAsync();

            if (userId.IsFailure)
            {
                _errors.Add(userId.Error.Description);

                return;
            }

            Result<GenerateMealPlanResponse> result = await Generate.Handle(
                new GenerateMealPlanCommand(
                    userId.Value, _name, _startDate, BuildConstraints(), _algorithm),
                CancellationToken.None);

            if (result.IsFailure)
            {
                Report(result.Error);

                return;
            }

            Navigation.NavigateTo($"plans/{result.Value.MealPlanId}");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CompareAsync()
    {
        _busy = true;
        _errors.Clear();

        try
        {
            Result<IReadOnlyCollection<SolverComparisonRow>> result =
                await Compare.Handle(
                    new CompareSolversQuery(BuildConstraints()),
                    CancellationToken.None);

            if (result.IsFailure)
            {
                _comparison = null;
                Report(result.Error);

                return;
            }

            _comparison = result.Value;
        }
        finally
        {
            _busy = false;
        }
    }

    private void Report(Error error)
    {
        // A validation error contans a list of errors,
        // other error types contain only one
        if (error is ValidationError validation)
        {
            _errors.AddRange(validation.Errors.Select(e => e.Description));
        }
        else
        {
            _errors.Add(error.Description);
        }
    }
}

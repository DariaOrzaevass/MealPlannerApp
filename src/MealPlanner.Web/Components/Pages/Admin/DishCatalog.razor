@page "/admin/dishes"
@using MealPlanner.Application.Abstractions.Messaging
@using MealPlanner.Application.Catalog.GetCatalogOptions
@using MealPlanner.Application.Dishes.CreateDish
@using MealPlanner.Application.Dishes.GetDishes
@using MealPlanner.Application.Dishes.SetDishPublication
@using MealPlanner.Domain.Abstractions
@using MealPlanner.Domain.Shared
@attribute [Authorize(Policy = Policies.Administrator)]
@rendermode InteractiveServer
@inject IQueryHandler<GetDishesQuery, DishPageResponse> Dishes
@inject IQueryHandler<GetCatalogOptionsQuery, CatalogOptionsResponse> Options
@inject ICommandHandler<CreateDishCommand, Guid> Create
@inject ICommandHandler<SetDishPublicationCommand> SetPublication

@* The authorization policy instead of specifying role directly in attribute -
the page states WHAT is required instead of WHO is allowed to acces this page *@

<PageTitle>Dish Catalog</PageTitle>

<div class="card">
    <h1>Dish Catalog</h1>

    <div class="actions">
        <input placeholder="Search by name" @bind="_search" @bind:event="oninput" />
        <label class="inline">
            <input type="checkbox" @bind="_publishedOnly" />
            Published dishes
        </label>
        <button @onclick="() => LoadAsync(1)">Search</button>
        <button class="primary" @onclick="() => _adding = !_adding">
            @(_adding ? "Hide form" : "Add dish")
        </button>
    </div>

    @if (_message is not null)
    {
        <p class="alert info">@_message</p>
    }

    @if (_errors.Count > 0)
    {
        <div class="alert error">
            <ul>
                @foreach (string error in _errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }
</div>

@if (_adding && _options is not null)
{
    <div class="card">
        <h2>New dish</h2>

        <div class="grid-2">
            <label>Name<input @bind="_newName" /></label>
            <label>Cost per serving, €<input type="number" step="0.01" @bind="_newCost" /></label>
            <label>Kilocalories<input type="number" @bind="_newCalories" /></label>
            <label>Cooking time in minutes<input type="number" @bind="_newCookingTime" /></label>
            <label>
                Diet
                <select @bind="_newDiet">
                    @foreach (DietType diet in Enum.GetValues<DietType>())
                    {
                        <option value="@diet">@Names.Of(diet)</option>
                    }
                </select>
            </label>
            <label>
                Cuisine
                <select @bind="_newCuisine">
                    @foreach (Cuisine cuisine in Enum.GetValues<Cuisine>())
                    {
                        <option value="@cuisine">@Names.Of(cuisine)</option>
                    }
                </select>
            </label>
        </div>

        <label>Description<input @bind="_newDescription" /></label>
        <label>Recipe<input @bind="_newRecipe" /></label>

        <h2>Suitable for</h2>
        <div class="checks">
            @foreach (MealTypes meal in new[] { MealTypes.Breakfast, MealTypes.Lunch, MealTypes.Dinner, MealTypes.Snack })
            {
                <label class="inline">
                    <input type="checkbox"
                           checked="@_newSuitableFor.HasFlag(meal)"
                           @onchange="e => ToggleMeal(meal, e)" />
                    @MealName(meal)
                </label>
            }
        </div>

        <h2>Ingredients</h2>
        <p class="muted">
            A dish cannot be published without ingredients, because in this case its allergen
            set will be empty. A dish like that will incorrectly pass all allergen filters.
        </p>
        <details>
            <summary class="muted">Ingredients selected: @_newIngredients.Count</summary>
            <div class="checks">
                @foreach (IngredientOption ingredient in _options.Ingredients)
                {
                    <label class="inline">
                        <input type="checkbox"
                               checked="@_newIngredients.ContainsKey(ingredient.Id)"
                               @onchange="e => ToggleIngredient(ingredient.Id, e)" />
                        @ingredient.Name
                    </label>
                }
            </div>
        </details>

        <p class="actions">
            <button class="primary" disabled="@_busy" @onclick="CreateAsync">Create</button>
            <span class="muted">The dish is created as unpublished.</span>
        </p>
    </div>
}

<div class="card">
    @if (_page is null)
    {
        <p class="muted">Loading...</p>
    }
    else
    {
        <p class="muted">
            Showing @_page.Items.Count from @_page.TotalCount,
            page @_page.Page of @(Math.Max(1, (_page.TotalCount + _page.PageSize - 1) / _page.PageSize))
        </p>
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th class="number">€</th>
                    <th class="number">Kcal</th>
                    <th class="number">Cooking time</th>
                    <th>Diet</th>
                    <th>Cuisine</th>
                    <th class="number">Ingredients</th>
                    <th>Publication</th>
                </tr>
            </thead>
            <tbody>
                @foreach (DishListItemResponse dish in _page.Items)
                {
                    <tr>
                        <td>@dish.Name</td>
                        <td class="number">@dish.Cost.ToString("0.##")</td>
                        <td class="number">@dish.Calories</td>
                        <td class="number">@dish.CookingTimeMinutes</td>
                        <td>@Names.Of(dish.Diet)</td>
                        <td>@Names.Of(dish.Cuisine)</td>
                        <td class="number">@dish.IngredientCount</td>
                        <td>
                            <button disabled="@_busy"
                                    @onclick="() => TogglePublicationAsync(dish)">
                                @(dish.IsPublished ? "Unpublish" : "Publish")
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <p class="actions">
            <button disabled="@(_page.Page <= 1 || _busy)" @onclick="() => LoadAsync(_page.Page - 1)">Previous</button>
            <button disabled="@(_page.Page * _page.PageSize >= _page.TotalCount || _busy)"
                    @onclick="() => LoadAsync(_page.Page + 1)">
                Next
            </button>
        </p>
    }
</div>

@code {
    private DishPageResponse? _page;
    private CatalogOptionsResponse? _options;
    private readonly List<string> _errors = [];
    private string? _message;
    private bool _busy;
    private bool _adding;

    private string _search = string.Empty;
    private bool _publishedOnly;

    private string _newName = string.Empty;
    private string _newDescription = string.Empty;
    private string _newRecipe = string.Empty;
    private decimal _newCost = 1m;
    private int _newCalories = 400;
    private int _newCookingTime = 20;
    private DietType _newDiet = DietType.Omnivore;
    private Cuisine _newCuisine = Cuisine.Other;
    private MealTypes _newSuitableFor = MealTypes.Lunch | MealTypes.Dinner;
    private readonly Dictionary<Guid, decimal> _newIngredients = [];

    protected override async Task OnInitializedAsync()
    {
        Result<CatalogOptionsResponse> options =
            await Options.Handle(new GetCatalogOptionsQuery(), CancellationToken.None);

        if (options.IsSuccess)
        {
            _options = options.Value;
        }

        await LoadAsync(1);
    }

    private async Task LoadAsync(int page)
    {
        Result<DishPageResponse> result = await Dishes.Handle(
            new GetDishesQuery(_search, _publishedOnly ? true : null, page),
            CancellationToken.None);

        if (result.IsSuccess)
        {
            _page = result.Value;
        }
    }

    private void ToggleMeal(MealTypes meal, ChangeEventArgs e) =>
        _newSuitableFor = e.Value is true ? _newSuitableFor | meal : _newSuitableFor & ~meal;

    private void ToggleIngredient(Guid id, ChangeEventArgs e)
    {
        if (e.Value is true)
        {
            // The quantity is not edited here, because ingredients are
            // needed mainly for allergen filtering and similarity calculations
            _newIngredients[id] = 100m;
        }
        else
        {
            _newIngredients.Remove(id);
        }
    }

    private async Task CreateAsync()
    {
        _busy = true;
        _errors.Clear();
        _message = null;

        try
        {
            var command = new CreateDishCommand(
                _newName,
                _newDescription,
                _newRecipe,
                _newCost,
                Currency.Eur.Code,
                _newCalories,
                _newSuitableFor,
                _newCookingTime,
                _newDiet,
                _newCuisine,
                [.. _newIngredients.Select(i => new DishIngredientInput(i.Key, i.Value, MeasurementUnit.Gram))]);

            Result<Guid> result = await Create.Handle(command, CancellationToken.None);

            if (result.IsFailure)
            {
                Report(result.Error);

                return;
            }

            _message = $"Dish «{_newName}» was created. Publish it so it can be used for the meal plan generation.";
            _adding = false;
            _newName = string.Empty;
            _newIngredients.Clear();

            await LoadAsync(1);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task TogglePublicationAsync(DishListItemResponse dish)
    {
        _busy = true;
        _errors.Clear();
        _message = null;

        try
        {
            Result result = await SetPublication.Handle(
                new SetDishPublicationCommand(dish.Id, !dish.IsPublished),
                CancellationToken.None);

            if (result.IsFailure)
            {
                Report(result.Error);

                return;
            }

            _message = dish.IsPublished
                ? $"«{dish.Name}» was unpublished. The catalog snapshot is invalidated."
                : $"«{dish.Name}» was published. The catalog snapshot is invalidated.";

            await LoadAsync(_page?.Page ?? 1);
        }
        finally
        {
            _busy = false;
        }
    }

    private void Report(Error error)
    {
        if (error is ValidationError validation)
        {
            _errors.AddRange(validation.Errors.Select(e => e.Description));
        }
        else
        {
            _errors.Add(error.Description);
        }
    }

    private static string MealName(MealTypes meal) => meal switch
    {
        MealTypes.Breakfast => "Breakfast",
        MealTypes.Lunch => "Lunch",
        MealTypes.Dinner => "Dinner",
        MealTypes.Snack => "Snack",
        _ => meal.ToString()
    };
}
